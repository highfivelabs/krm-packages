{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hfl.dev/schemas/composer/chartspec.v1alpha1.json",
  "title": "ChartSpec",
  "description": "What the Bundt chart composer compiles into a Helm chart. Agents write or edit a ChartSpec, never templates. A field bound to a value holds ${values.<name>}: the whole string takes the value with its type; inside a longer string it interpolates. A labels map may hold \"$merge\": \"${values.labels}\". A cloud-assigned resource ID holds ${resourceIds.<resource id>}. A resource's name, and every reference to it inside the chart, holds ${name.<resource id>}: its nameDefault unless the names value overrides it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "source", "chart", "values", "resources"],
  "properties": {
    "apiVersion": { "const": "composer.bundt.hfl.dev/v1alpha1" },
    "kind": { "const": "ChartSpec" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/dnsName" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["terraform-state", "intent", "working-set", "chart"] },
        "state": { "type": "string" },
        "tool": { "enum": ["terraform", "opentofu"] },
        "form": { "enum": ["state", "show-json"] },
        "terraformVersion": { "type": "string", "description": "The version of Terraform or OpenTofu that last wrote the state." },
        "call": { "type": "string" },
        "addresses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/dnsName" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string" }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tier", "type", "default", "description", "uses"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "tier": { "enum": ["placement", "knob", "adoption", "override"] },
          "type": { "enum": ["string", "integer", "number", "boolean", "object", "array"] },
          "default": {},
          "description": { "type": "string", "minLength": 1 },
          "identity": { "type": "boolean" },
          "uses": { "type": "integer", "minimum": 0 }
        }
      },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "projectId" } } } },
        { "contains": { "properties": { "name": { "const": "region" } } } },
        { "contains": { "properties": { "name": { "const": "network" } } } },
        { "contains": { "properties": { "name": { "const": "subnetwork" } } } },
        { "contains": { "properties": { "name": { "const": "codeName" } } } },
        { "contains": { "properties": { "name": { "const": "environment" } } } },
        { "contains": { "properties": { "name": { "const": "labels" } } } }
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "object"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "stateful": { "type": "boolean" },
          "identityFields": { "type": "array", "items": { "type": "string" } },
          "nameDefault": { "type": "string", "description": "The name when the names value does not override it; metadata.name and references inside the chart hold ${name.<id>}." },
          "object": {
            "type": "object",
            "required": ["apiVersion", "kind", "metadata"]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string", "description": "CEL over resources (by hfl.dev/id) and inputs." }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "resource": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "dnsName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" }
  }
}
