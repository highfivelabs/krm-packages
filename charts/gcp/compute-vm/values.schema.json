        "auto_delete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "force_attach": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "snapshot_schedule": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "initialize_params": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "hyperdisk": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "provisioned_iops": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "provisioned_throughput": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "storage_pool": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "attach": {
              "type": [
                "string",
                "null"
              ]
            },
            "disk": {
              "type": [
                "string",
                "null"
              ]
            },
            "image": {
              "type": [
                "string",
                "null"
              ]
            },
            "snapshot": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "use_independent_disk": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "can_ip_forward": {
      "description": "Enable IP forwarding.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "confidential_compute": {
      "description": "Confidential Compute configuration. Set to 'SEV' or 'SEV_SNP' to enable.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SEV",
        "SEV_SNP",
        null
      ]
    },
    "context": {
      "description": "Not supported: use Bundt's ${...} expressions and valueFrom instead.",
      "type": [
        "object",
        "null"
      ]
    },
    "create_template": {
      "description": "Create instance template instead of instances. Defaults to a global template; regional (an alpha kind not ported yet) is refused.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "regional": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "deletion_policy": {
      "description": "Not a fabric variable: DELETE (default) or ABANDON; PREVENT is refused.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT",
        null
      ]
    },
    "description": {
      "description": "Description of a Compute Instance.",
      "type": [
        "string",
        "null"
      ]
    },
    "enable_display": {
      "description": "Enable virtual display on the instances.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "encryption": {
      "description": "Encryption options. disk_encryption_key_raw is refused: the key would be in the rendered manifest.",
