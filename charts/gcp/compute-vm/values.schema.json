{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "compute-vm values (fabric compute-vm v60.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "network_interfaces",
    "project_id",
    "zone"
  ],
  "properties": {
    "labels": {
      "description": "fabric's instance labels; as every chart's labels, Kubernetes labels on every object (an unprefixed key is also a Google Cloud label).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "namePrefix": {
      "description": "Optional convenience (not a Terraform variable): <namePrefix>- in front of every derived name. A DNS label. Empty changes nothing.",
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "names": {
      "description": "Cloud names in full (not Terraform variables; docs/design.md, \"Names, labels and tags\"): the instance's, the unmanaged group's, the instance schedule policy's, the created service account's ID and the instance template's base name. A name set here takes no prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "instanceSchedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "serviceAccount": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 54,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "tags": {
      "description": "fabric's network tags (a list), or, as every chart's tags, cloud labels (a map) on every resource that takes them.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]([a-z0-9_-]{0,61}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^([a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?)?$"
          }
        }
      ]
    },
    "allow_alpha": {
      "description": "Accept features that need an alpha (v1alpha1) Config Connector kind.",
      "type": "boolean"
    },
    "attached_disks": {
      "description": "Additional disks. Source type is one of 'image' (zonal disks in vms and template), 'snapshot' (vm), 'existing', and null.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "auto_delete": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "device_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "force_attach": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "READ_WRITE",
              "READ_ONLY",
              null
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "initialize_params": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "replica_zone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "size": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hyperdisk": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "provisioned_iops": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "provisioned_throughput": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "storage_pool": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "snapshot_schedule": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "attach": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "snapshot": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "boot_disk": {
      "description": "Boot disk properties.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": [
            "string",
