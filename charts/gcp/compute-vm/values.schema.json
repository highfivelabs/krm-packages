      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": [
            "nvidia-tesla-a100",
            "nvidia-tesla-p100",
            "nvidia-tesla-p100-vws",
            "nvidia-tesla-v100",
            "nvidia-tesla-p4",
            "nvidia-tesla-p4-vws",
            "nvidia-tesla-t4",
            "nvidia-tesla-t4-vws",
            "nvidia-l4",
            "nvidia-l4-vws",
            "nvidia-a100-80gb",
            "nvidia-h100-80gb",
            "nvidia-h100-mega-80gb",
            "nvidia-h200-141gb"
          ]
        }
      },
      "required": [
        "count",
        "type"
      ]
    },
    "group": {
      "description": "Instance group configuration: named_ports makes an unmanaged group; membership (joining an existing group) is refused.",
      "type": [
