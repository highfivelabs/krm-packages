{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "route53 values (terraform-aws-modules route53 v6.5.1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "namePrefix": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "allow_alpha": {
      "type": "boolean"
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{12}$"
    },
    "deletion_policy": {
      "type": "string",
      "enum": [
        "DELETE",
        "ABANDON",
        "PREVENT"
      ]
    },
    "create": {
      "type": "boolean",
      "description": "Whether to create Route53 zone"
    },
    "tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Tags added to all zones"
    },
    "create_zone": {
      "type": "boolean",
      "description": "Determines whether to create the Route53 zone or lookup an existing zone",
      "enum": [
        true,
        false
      ]
    },
    "ignore_vpc": {
      "type": "boolean",
      "description": "Determines whether to ignore VPC association changes after creation",
      "enum": [
        true,
        false
      ]
    },
    "private_zone": {
      "type": "boolean",
      "description": "Whether the hosted zone is private. Only applicable when create_zone = false",
      "enum": [
        true,
        false
      ]
    },
    "vpc_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ID of the VPC associated with the existing hosted zone"
    },
    "comment": {
      "type": [
        "string",
        "null"
      ],
      "description": "A comment for the hosted zone"
    },
    "delegation_set_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ID of the reusable delegation set"
    },
    "force_destroy": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether to destroy all records in the zone when destroying the zone"
    },
    "enable_accelerated_recovery": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether to enable Route 53 Accelerated Recovery"
    },
    "name": {
      "type": "string",
      "description": "This is the name of the hosted zone"
    },
    "vpc": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "vpc_id": {
            "type": "string"
          },
          "vpc_region": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "vpc_id"
        ]
      },
      "description": "VPC(s) to associate with a private hosted zone"
    },
    "timeouts": {
      "type": [
        "object",
        "null"
      ],
      "description": "Timeouts for the Route53 zone operations (not supported)"
    },
    "vpc_association_authorizations": {
      "type": [
        "object",
        "null"
      ],
      "description": "A map of VPC association authorizations to create for the Route53 zone (not supported)"
    },
    "enable_dnssec": {
      "type": "boolean",
      "description": "Whether to enable DNSSEC for the Route53 zone",
      "enum": [
        true,
        false
      ]
    },
    "create_dnssec_kms_key": {
      "type": "boolean",
      "description": "Whether to create a KMS key for DNSSEC signing",
      "enum": [
        true,
        false
      ]
    },
    "dnssec_kms_key_arn": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ARN of the KMS key to use for DNSSEC signing"
    },
    "dnssec_kms_key_description": {
      "type": [
        "string",
        "null"
      ],
      "description": "The description of the key as viewed in AWS console"
    },
    "dnssec_kms_key_aliases": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "A list of aliases to create"
    },
    "dnssec_kms_key_tags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Additional tags for the DNSSEC KMS key"
    },
    "dnssec_key_signing_key_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the Route 53 key signing key (KSK)"
    },
    "records": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "evaluate_target_health": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "zone_id": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "zone_id"
            ]
          },
          "allow_overwrite": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "cidr_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "collection_id": {
                "type": "string"
              },
              "location_name": {
                "type": "string"
              }
            },
            "required": [
              "collection_id",
              "location_name"
            ]
          },
          "failover_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PRIMARY",
                  "SECONDARY"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "geolocation_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "continent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subdivision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "geoproximity_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "aws_region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bias": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "coordinates": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "latitude": {
                      "type": "number"
                    },
                    "longitude": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "latitude",
                    "longitude"
                  ]
                }
              },
              "local_zone_group": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "health_check_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "region": {
                "type": "string"
              }
            },
            "required": [
              "region"
            ]
          },
          "multivalue_answer_routing_policy": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "full_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "records": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "set_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "ttl": {
            "type": [
              "number",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "weighted_routing_policy": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "weight": {
                "type": "number"
              }
            },
            "required": [
              "weight"
            ]
          },
          "timeouts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "create": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "update": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "delete": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "type"
        ]
      },
      "description": "A map of Route53 records to create in the zone"
    }
  }
}
