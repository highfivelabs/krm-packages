# Environment identifiers for live tests and offload runs. Copy to .env
# (git-ignored; Taskfile.yml and hack/ci/gate.sh load it) and fill in.
# Placeholders only: never commit real values.

# The Google Cloud project live tests run in (hack/live-apply.sh refuses
# any other, except HFL_GCP_TEST_PROJECT when the test estate's env file
# sets it).
GCP_PROJECT=my-dev-project
# The service account `task test-live` runs as on the offload VM (no keys).
GCP_LIVE_SA=catalog-live-tests@my-dev-project.iam.gserviceaccount.com
# The service account the kcc-tf-kind spike runs as
# (hack/terraform/spikes/kcc-tf-kind/run.sh).
GCP_CCE_LIVE_SA=cce-live-tests@my-dev-project.iam.gserviceaccount.com
# The offramp's folders and platform-project shapes (task offramp-live):
# the live-tests folder the run's folders and project go under, its
# organization, and the billing account the platform project links to.
# GCP_CCE_LIVE_SA needs folderAdmin, projectCreator and the two firewall
# policy roles on the folder and billing.user on the account. Without
# roles/orgpolicy.policyAdmin on the organization, set
# OFFRAMP_ORG_POLICIES=false to leave the folders shape's three
# organization policies out.
OFFRAMP_PARENT=folders/000000000000
OFFRAMP_ORG_ID=000000000000
OFFRAMP_BILLING_ACCOUNT=000000-000000-000000
OFFRAMP_ORG_POLICIES=true
# Without compute.globalOperations.get on the organization (a hierarchical
# firewall policy's operations are named after it), set
# OFFRAMP_FOLDER_FIREWALL=false to leave the folders shape's firewall
# policy out.
OFFRAMP_FOLDER_FIREWALL=true
# The account the folders and platform-project shapes act as, by
# impersonation from the offload VM's own account (offload run
# --impersonate): live-tests@ in the organization's own testing project,
# which tf-infra (dev/gcp/projects/hfl-testing) makes and grants: the
# live-tests folder's roles, billing.user, quota, asset and log read in
# GCP_PROJECT, read on the offload bucket, and token creation for the
# offload runner. Empty: those shapes run the VM as GCP_CCE_LIVE_SA, as the
# other shapes do.
OFFRAMP_LIVE_SA=live-tests@my-testing-project.iam.gserviceaccount.com
# The principal the fixtures grant their roles to (empty: the live-test
# service account). An organization with iam.allowedPolicyMemberDomains
# refuses a service account whose project was made in another one; then
# name a user or group of the organization's own customer.
OFFRAMP_MEMBER=
# The offload project and bucket (the names scripts/offload reads): run
# logs and the config-connector-extensions snapshot go to the bucket.
OFFLOAD_PROJECT=my-dev-project
OFFLOAD_BUCKET=gs://my-dev-project-offload

# Azure live tests (task test-live-azure, hack/azure-live.sh): the sandbox
# subscription, its tenant, the app registration the offload VMs' service
# account is federated to (no secret), the one resource group it may touch,
# and that service account (offload --sa).
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_LIVE_RESOURCE_GROUP=my-live-tests
AZURE_LIVE_SA=offload@my-dev-project.iam.gserviceaccount.com
